# Database
DATABASE_URL=postgresql://user:password@localhost:5432/heading

# NextAuth
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=your-secret-here-generate-with-openssl-rand-base64-32

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Anthropic Claude API
ANTHROPIC_API_KEY=your-claude-api-key

# Crew integration (todo hub)
# Base URL of the deployed Crew app, no trailing slash.
CREW_API_URL=https://crew.example.com
# Bearer token for calling Crew. Must equal Crew's CREW_INTEGRATION_HEADING value.
CREW_INTEGRATION_TOKEN=
# Shared secret Crew sends on the completion webhook. Must equal Crew's HEADING_WEBHOOK_SECRET value.
CREW_WEBHOOK_SECRET=

# Environment
NODE_ENV=development
